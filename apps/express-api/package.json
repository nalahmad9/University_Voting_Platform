{
  "name": "@quorum/express-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/lib/blind-voting.test.ts src/lib/anomaly-intelligence.test.ts src/lib/receipt-verification.test.ts src/lib/tally.test.ts src/lib/manifesto-intelligence.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@cloudflare/blindrsa-ts": "^0.4.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@quorum/shared": "*",
    "@supabase/supabase-js": "^2.57.4",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
